#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++#
# UCF for Mimas V2 - Inline NIDS (2x LAN8720 RMII).  Based on the user's board UCF.                   #
# Only the nets that exist in nids_top.v are active; every other board section is commented out.      #
# Header bit numbering: header pin N  ->  IO_Pxx[N-1]   (P9.1 = IO_P9[0] ... P9.8 = IO_P9[7])         #
#+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++#

CONFIG VCCAUX = "3.3" ;

###################################################################################################################################################
#                                         100 MHz master oscillator                                                                               #
###################################################################################################################################################
    NET "clk_100"             LOC = V10 | IOSTANDARD = LVCMOS33;
    NET "clk_100"             TNM_NET = "clk_100";
    TIMESPEC TS_clk_100       = PERIOD "clk_100" 10 ns HIGH 50%;

###################################################################################################################################################
#                                         FT2232 USB-UART  (FPGA TX -> PC)                                                                        #
# NOTE: your board UCF did not list the UART pins.  B8 = FPGA TX is from my recollection of Numato's     #
# reference design - confirm against the Mimas V2 manual/schematic.  (A8 is the FPGA RX side.)            #
###################################################################################################################################################
    NET "uart_txd"            LOC = B8  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST;

###################################################################################################################################################
#                       PHY A (Attacker)  -  P9 header + P8.2                                                                                     #
###################################################################################################################################################
    NET "phy_a_txd[1]"        LOC = T11 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX1     P8.2  = IO_P8[1]
    NET "phy_a_txd[0]"        LOC = H17 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX0     P9.1  = IO_P9[0]
    NET "phy_a_tx_en"         LOC = H18 | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX_EN   P9.2  = IO_P9[1]
    NET "phy_a_rxd[1]"        LOC = J16 | IOSTANDARD = LVCMOS33 ;                             # RX1     P9.3  = IO_P9[2]
    NET "phy_a_rxd[0]"        LOC = J18 | IOSTANDARD = LVCMOS33 ;                             # RX0     P9.4  = IO_P9[3]
    NET "phy_a_crs_dv"        LOC = K15 | IOSTANDARD = LVCMOS33 ;                             # CRS     P9.5  = IO_P9[4]
    NET "phy_a_ref_clk"       LOC = K16 | IOSTANDARD = LVCMOS33 ;                             # REFCLK  P9.6  = IO_P9[5]
#   MDC   P9.7 = IO_P9[6] = L15  (not used by this design - management interface left idle)
#   MDIO  P9.8 = IO_P9[7] = L16  (not used by this design)

###################################################################################################################################################
#                       PHY B (Victim)  -  P6 header + P7.2                                                                                       #
###################################################################################################################################################
    NET "phy_b_txd[1]"        LOC = V8  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX1     P7.2  = IO_P7[1]
    NET "phy_b_txd[0]"        LOC = U7  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX0     P6.1  = IO_P6[0]
    NET "phy_b_tx_en"         LOC = V7  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;   # TX_EN   P6.2  = IO_P6[1]
    NET "phy_b_rxd[1]"        LOC = T4  | IOSTANDARD = LVCMOS33 ;                             # RX1     P6.3  = IO_P6[2]
    NET "phy_b_rxd[0]"        LOC = V4  | IOSTANDARD = LVCMOS33 ;                             # RX0     P6.4  = IO_P6[3]
    NET "phy_b_crs_dv"        LOC = U5  | IOSTANDARD = LVCMOS33 ;                             # CRS     P6.5  = IO_P6[4]
    NET "phy_b_ref_clk"       LOC = V5  | IOSTANDARD = LVCMOS33 ;                             # REFCLK  P6.6  = IO_P6[5]
#   MDC   P6.7 = IO_P6[6] = R3   (not used by this design)
#   MDIO  P6.8 = IO_P6[7] = T3   (not used by this design)

###################################################################################################################################################
#   REF_CLKs arrive on general header pins, not guaranteed GCLK inputs: allow the IBUF -> BUFG route                                              #
###################################################################################################################################################
    NET "phy_a_ref_clk"       CLOCK_DEDICATED_ROUTE = FALSE;
    NET "phy_b_ref_clk"       CLOCK_DEDICATED_ROUTE = FALSE;

###################################################################################################################################################
#   Independent, unrelated PHY clock domains (each PHY is clock master)                                                                           #
###################################################################################################################################################
    NET "phy_a_ref_clk"       TNM_NET = "clk_a";
    TIMESPEC TS_clk_a         = PERIOD "clk_a" 20 ns HIGH 50%;

    NET "phy_b_ref_clk"       TNM_NET = "clk_b";
    TIMESPEC TS_clk_b         = PERIOD "clk_b" 20 ns HIGH 50%;

###################################################################################################################################################
#   RMII I/O timing vs. each PHY's own REF_CLK  (LAN8720 datasheet: output valid ~3..14 ns after REF_CLK rise,                                    #
#   TX setup 4 ns / hold 1.5 ns).  Verify the numbers against your PHY's datasheet revision.                                                      #
#   These make ISE choose input delays / report real margins instead of ignoring the I/O paths.                                                   #
###################################################################################################################################################
    NET "phy_a_rxd[0]"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_a_ref_clk" RISING;
    NET "phy_a_rxd[1]"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_a_ref_clk" RISING;
    NET "phy_a_crs_dv"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_a_ref_clk" RISING;
    NET "phy_b_rxd[0]"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_b_ref_clk" RISING;
    NET "phy_b_rxd[1]"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_b_ref_clk" RISING;
    NET "phy_b_crs_dv"  OFFSET = IN  6 ns VALID 9 ns BEFORE "phy_b_ref_clk" RISING;

    NET "phy_a_txd[0]"  OFFSET = OUT 14 ns AFTER "phy_a_ref_clk" RISING;
    NET "phy_a_txd[1]"  OFFSET = OUT 14 ns AFTER "phy_a_ref_clk" RISING;
    NET "phy_a_tx_en"   OFFSET = OUT 14 ns AFTER "phy_a_ref_clk" RISING;
    NET "phy_b_txd[0]"  OFFSET = OUT 14 ns AFTER "phy_b_ref_clk" RISING;
    NET "phy_b_txd[1]"  OFFSET = OUT 14 ns AFTER "phy_b_ref_clk" RISING;
    NET "phy_b_tx_en"   OFFSET = OUT 14 ns AFTER "phy_b_ref_clk" RISING;

###################################################################################################################################################
#   Clock-domain crossings are handled in RTL (Gray-pointer sync, toggle sync, reset sync)                                                        #
###################################################################################################################################################
    TIMESPEC TS_a2b           = FROM "clk_a"   TO "clk_b"   TIG;
    TIMESPEC TS_b2a           = FROM "clk_b"   TO "clk_a"   TIG;
    TIMESPEC TS_a2100         = FROM "clk_a"   TO "clk_100" TIG;
    TIMESPEC TS_100a          = FROM "clk_100" TO "clk_a"   TIG;
    TIMESPEC TS_b2100         = FROM "clk_b"   TO "clk_100" TIG;
    TIMESPEC TS_100b          = FROM "clk_100" TO "clk_b"   TIG;

###################################################################################################################################################
#   Unused board peripherals from the stock Mimas V2 UCF (DIP switches, push buttons, LEDs, 7-seg, audio, VGA, P7/P8/P9 spare bits)              #
#   are intentionally omitted: constraining nets that do not exist in nids_top only produces warnings.  Copy lines back in if you add ports.     #
###################################################################################################################################################

    NET "SevenSegmentEnable[2]"           LOC = B3  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;                              # Enables for Seven Segment
    NET "SevenSegmentEnable[1]"           LOC = A2  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;
    NET "SevenSegmentEnable[0]"           LOC = B2  | IOSTANDARD = LVCMOS33 | DRIVE = 8 | SLEW = FAST ;