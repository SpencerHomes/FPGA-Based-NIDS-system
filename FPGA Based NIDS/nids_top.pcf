        "u_uart/idx_2_1" BEL "u_uart/idx_3_1" BEL "u_uart/sid_5_1" BEL
        "u_uart/sid_1_1" BEL "u_uart/idx_1_1" BEL "u_uart/idx_3_2" BEL
        "u_uart/idx_2_2" BEL "u_uart/sid_4_2" BEL "u_uart/sid_6_1" BEL
        "u_uart/sid_0_1" BEL "u_uart/sid_1_2" BEL "u_uart/sid_2_2" BEL
        "u_uart/sid_3_2" BEL "u_uart/idx_0_1" BEL "clk_100_BUFGP/BUFG";
TS_clk_100 = PERIOD TIMEGRP "clk_100" 10 ns HIGH 50%;
TS_clk_a = PERIOD TIMEGRP "clk_a" 20 ns HIGH 50%;
TS_clk_b = PERIOD TIMEGRP "clk_b" 20 ns HIGH 50%;
PATH TS_a2b_path = FROM TIMEGRP "clk_a" TO TIMEGRP "clk_b";
PATH "TS_a2b_path" TIG;
PATH TS_b2a_path = FROM TIMEGRP "clk_b" TO TIMEGRP "clk_a";
PATH "TS_b2a_path" TIG;
PATH TS_a2100_path = FROM TIMEGRP "clk_a" TO TIMEGRP "clk_100";
PATH "TS_a2100_path" TIG;
PATH TS_100a_path = FROM TIMEGRP "clk_100" TO TIMEGRP "clk_a";
PATH "TS_100a_path" TIG;
PATH TS_b2100_path = FROM TIMEGRP "clk_b" TO TIMEGRP "clk_100";
PATH "TS_b2100_path" TIG;
PATH TS_100b_path = FROM TIMEGRP "clk_100" TO TIMEGRP "clk_b";
PATH "TS_100b_path" TIG;
SCHEMATIC END;

